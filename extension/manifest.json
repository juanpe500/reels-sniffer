{
  "manifest_version": 3,
  "name": "Reels Sniffer",
  "version": "1.0.0",
  "description": "Scroll an Instagram profile's reels tab to harvest every reel's view count, rank them high→low, and store a per-user leaderboard locally.",
  "permissions": ["storage"],
  "host_permissions": ["https://www.instagram.com/*"],
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://www.instagram.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_title": "Reels Sniffer — open leaderboard",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
